{
  "name": "rx-website-benchmark",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "step1": "node scripts/step1-fetch-medicare-drugs.js",
    "step2": "node scripts/step2-validate-fda.js",
    "step3": "node scripts/step3-generate-websites.js",
    "step4": "node scripts/step4-apply-redirects.js",
    "step5": "node scripts/step5-generate-urls-list.js",
    "lighthouse": "npx lighthouse-batch --html  -f src/lib/sites.txt --out static/lighthouse",
    "generate": "node scripts/step5-generate-urls-list.js",
    "group-al11y:a": "node scripts/group-al11y-results.js --A",
    "group-al11y:aa": "node scripts/group-al11y-results.js --AA",
    "group-al11y:aaa": "node scripts/group-al11y-results.js --AAA",
    "pa11y:a": "npx pa11y-ci --config .pa11yci-a.json",
    "pa11y:aa": "npx pa11y-ci --config .pa11yci-aa.json",
    "pa11y:manual": "npx pa11y-ci --config .pa11yci-manual.json",
    "readability": "node scripts/check-readability.js",
    "manual-readability": "node scripts/manual-check-readability.js",
    "crux": "node --env-file=.env scripts/check-crux-history.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "dictionary-en": "^4.0.0",
    "jsdom": "^25.0.1",
    "nspell": "^2.1.5",
    "puppeteer": "^24.34.0",
    "text-readability": "^1.1.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "pa11y-ci": "^4.0.1",
    "pa11y-ci-reporter-html": "^8.0.1",
    "pa11y-reporter-html": "^2.0.0",
    "svelte": "^5.41.0",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.10",
    "vite-plugin-devtools-json": "^1.0.0"
  }
}
